# Names only. Copy to .env.local and fill in the values there.
# Secrets are server-side only: nothing here may use the NEXT_PUBLIC_ prefix.

# Supabase (runtime). One of the two keys is enough; the secret key is preferred.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Supabase (builder only: migrations and generated types; not set in Vercel)
SUPABASE_ACCESS_TOKEN=
SUPABASE_PROJECT_REF=
SUPABASE_DB_PASSWORD=

# ElevenLabs
ELEVENLABS_API_KEY=
ELEVENLABS_INTERVIEWER_AGENT_ID=
ELEVENLABS_TUTOR_AGENT_ID=

# Model router
ANTHROPIC_API_KEY=
VISION_FAST_MODEL=
VISION_STRONG_MODEL=
TEXT_MODEL=
PLAN_MODEL=

# Accounts: "required" makes a new account confirm its email first (needs SMTP set up in Supabase)
EMAIL_CONFIRMATION=
# Sessions one account may start in 24 hours; 5 when unset, "none" for no limit
DAILY_SESSION_LIMIT=
# Tiro's own services
TIRO_MCP_SECRET=
CRAWL_WORKER_SECRET=

# Public research for the baseline
BRIGHTDATA_API_KEY=
