{
  "name": "tiro",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "types:db": "npx supabase gen types typescript --project-id \"$SUPABASE_PROJECT_REF\" --schema public,evaluation > src/contract/database.types.ts",
    "agents:push": "node --env-file=.env.local scripts/agents-push.mjs",
    "spike:s1": "node --env-file=.env.local --conditions=react-server --import tsx scripts/spikes/s1-replay.mts",
    "spike:s3": "node --env-file=.env.local scripts/spikes/s3-key-frame.mjs",
    "signup-code": "node --env-file=.env.local scripts/signup-code.mjs",
    "demo-accounts": "node --env-file=.env.local scripts/demo-accounts.mjs",
    "check:accounts": "node --env-file=.env.local scripts/accounts-check.mjs",
    "check:agent": "node --env-file=.env.local scripts/agent-check.mjs",
    "check:debrief": "node --env-file=.env.local scripts/debrief-check.mjs",
    "check:session": "node --env-file=.env.local scripts/e2e/session.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.131.0",
    "@elevenlabs/client": "^1.26.0",
    "@supabase/supabase-js": "^2.117.2",
    "next": "16.3.8",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "playwright-core": "1.63.0",
    "sharp": "^0.35.5",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": "24.x"
  }
}
