{
  "name": "Tiro tutor",
  "tags": [
    "tiro"
  ],
  "conversation_config": {
    "turn": {
      "turn_timeout": -1,
      "silence_end_call_timeout": -1,
      "turn_eagerness": "patient"
    },
    "conversation": {
      "max_duration_seconds": 3600,
      "client_events": [
        "conversation_initiation_metadata",
        "ping",
        "audio",
        "interruption",
        "user_transcript",
        "agent_response",
        "agent_response_correction",
        "client_tool_call"
      ]
    },
    "agent": {
      "first_message": "",
      "language": "en",
      "prompt": {
        "llm": "claude-sonnet-5-5",
        "built_in_tools": {
          "skip_turn": {
            "type": "system",
            "name": "skip_turn",
            "description": "",
            "params": {
              "system_tool_type": "skip_turn"
            }
          }
        }
      }
    }
  },
  "platform_settings": {
    "auth": {
      "enable_auth": true
    },
    "overrides": {
      "conversation_config_override": {
        "agent": {
          "language": true
        }
      }
    }
  }
}
